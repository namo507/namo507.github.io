{
    "name": "Academic Pages",
    "dockerComposeFile": "../docker-compose.yaml",
    "service": "jekyll-site",
    "workspaceFolder": "/usr/src/app",
    "remoteUser": "vscode",
    "overrideCommand": false,
    "shutdownAction": "stopCompose",
    "forwardPorts": [4000],
    "portsAttributes": {
        "4000": {"label": "Portfolio preview", "onAutoForward": "notify"}
    }
}
