{
  "name": "academic-pages",
  "version": "0.8.1.1",
  "description": "Academic Pages Mistakes Jekyll theme npm build scripts",
  "repository": {
    "type": "git",
    "url": "https://github.com/academicpages/academicpages.github.io"
  },
  "keywords": [
    "jekyll",
    "theme",
    "minimal"
  ],
  "contributors": [
    "Michael Rose",
    "Robert Zupko"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/academicpages/academicpages.github.io/issues"
  },
  "homepage": "https://github.com/academicpages/academicpages.github.io",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fitvids": "^2.1.1",
    "jquery": "^3.7.1",
    "jquery-smooth-scroll": "^2.2.0",
    "plotly.js-dist-min": "^3.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.160.0"
  },
  "devDependencies": {
    "esbuild": "0.25.9",
    "onchange": "^7.1.0",
    "uglify-js": "^3.17.4"
  },
  "scripts": {
    "build:cosmic": "esbuild assets/cosmic/app.jsx --bundle --minify --format=iife --target=es2020 --legal-comments=external --outfile=assets/cosmic/app.min.js && esbuild assets/cosmic/explainers-3d.js --bundle --minify --format=esm --target=es2020 --legal-comments=external --outfile=assets/cosmic/explainers-3d.min.js",
    "uglify": "node scripts/build-classic.cjs",
    "watch:js": "onchange \"assets/js/**/*.js\" -e \"assets/js/main.min.js\" -- npm run build:js",
    "build:js": "npm run uglify"
  }
}
